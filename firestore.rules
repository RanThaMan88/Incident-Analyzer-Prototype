rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isOwner(userId) && isValidId(userId);
      // Writes happen via backend admin SDK in sync, but client might need to update minor fields
      allow write: if isOwner(userId) && isValidId(userId);
    }
    
    // Allow public access to cases and sub-collections for this independent service
    match /cases/{caseId} {
      allow read, write: if true;
      
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Connection test document
    match /test/connection {
       allow read: if true;
    }
  }
}
